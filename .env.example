# Public, build-time config for the static SPA.
# Copy to .env.local for local development. All NEXT_PUBLIC_* values are
# embedded in the browser bundle — that's expected: they are non-secret
# (Supabase anon key is protected by Row Level Security).

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Google Calendar uses a public calendar + a restricted API key baked into
# lib/google-calendar.ts — no build-time Google config needed here.

# Base path for GitHub Pages project sites: "/<repo-name>".
# Leave EMPTY for a <user>.github.io user/organization site.
NEXT_PUBLIC_BASE_PATH=""
